{
	"name": "auto-file-extension",
	"version": "1.1.0",
	"description": "Obsidian plugin to set file extensions automatically based on directory and content rules.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test-copy": "node scripts/copy-to-test-vault.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"bump": "node scripts/version-prompt.mjs",
		"lint": "eslint .",
		"prettier": "prettier . --write"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.4",
		"prettier": "^3.9.6"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
