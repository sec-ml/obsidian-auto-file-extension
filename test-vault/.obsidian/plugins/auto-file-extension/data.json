{
  "rules": [
    {
      "type": "content",
      "label": "Content regex match",
      "pattern": "@regex",
      "extension": "mdx"
    },
    {
      "type": "both",
      "directory": "both-folder",
      "label": "Directory and content (both)",
      "pattern": "@both",
      "extension": "svx"
    },
    {
      "type": "directory",
      "label": "Specific directory",
      "directory": "specific-folder",
      "extension": "rmd"
    },
    {
      "type": "directory",
      "label": "Recursive directory",
      "directory": "recursive-folder/*",
      "extension": "qmd"
    },
    {
      "type": "directory",
      "label": "Vault root",
      "directory": "/",
      "extension": "mdown"
    }
  ],
  "revertToMd": true,
  "showRenameNotifications": true,
  "runOnModify": false,
  "usePathExtension": false,
  "debugToConsole": false
}